<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ServiceTicketMaui.PageModels"             
             xmlns:models="clr-namespace:ServiceTicketMaui.Models"
             xmlns:controls="clr-namespace:ServiceTicketMaui.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ServiceTicketMaui.Pages.MainPage"
             x:Name="OverviewPage"
             Title="Service Tickets">
<!--Enables Scrolling to view all Tickets-->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Service Tickets"
               FontSize="24"
               FontAttributes="Bold" />

            <Button Text="Load Tickets"
                Clicked="OnLoadTicketsClicked" />

            <CollectionView x:Name="TicketsCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!--Border color matches background-->
                        <Border Padding="15"
                                Margin="0,10" 
                                Stroke="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                                StrokeThickness="3">
                            <!--Breathing Room Between Cards-->
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Opacity" Value="1" />
                                        </VisualState.Setters>
                                        <!--Adjust opacity when hover over ticket-->
                                    </VisualState>
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Opacity" Value="0.8" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border.Triggers>
                                <!--Frames are obsolete, switch to Border-->
                                <!--For color-coding, the simplest way in XAML is a DataTrigger. 
                                No new C# file is needed, just three small blocks that say "If status equals this text, 
                                set the background to this color."-->
                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="New">
                                    <Setter Property="BackgroundColor" Value="#3A6A6B" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="In Progress">
                                    <Setter Property="BackgroundColor" Value="#384466" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Closed">
                                    <Setter Property="BackgroundColor" Value="#5A3C62" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding TicketId, StringFormat='Ticket #{0}'}"
                                   FontSize="12" />
                                <Label Text="{Binding Title}"
                                   FontAttributes="Bold" />
                                <Label Text="{Binding Description}" />
                                <Label Text="{Binding Status}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
